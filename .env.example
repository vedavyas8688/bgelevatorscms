# Copy to .env at the repository root. Never commit .env.
NODE_ENV=development
PORT=4000
API_URL=http://127.0.0.1:4000
# Local MongoDB or your MongoDB Atlas connection string:
MONGODB_URI=mongodb://127.0.0.1:27017/bg_elevators
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173
TRUST_PROXY=0
# Used to create or reset the administrator. Minimum password length: 10.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=BG Administrator
# Optional ImageKit. Without it, uploads are stored in ./uploads.
IMAGEKIT_PRIVATE_KEY=
UPLOAD_DIR=
# Optional email notification. All submissions are saved even if email is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENQUIRY_EMAIL=
# Docker Compose MongoDB credentials: set before starting Docker.
MONGO_ROOT_USERNAME=bg_owner
MONGO_ROOT_PASSWORD=
